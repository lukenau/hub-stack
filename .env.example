# hub-stack configuration.  Copy to `.env` (install.sh does this for you).
# Everything here is optional except where marked REQUIRED.
# Secrets belong in this file only — never commit it (it is gitignored).

# ─── server ────────────────────────────────────────────────────────────────
# Where the server listens inside the container (leave as-is for Docker).
HUB_API_HOST=0.0.0.0
HUB_API_PORT=8090

# Host-side publish address. 127.0.0.1 = reachable from this machine only.
# Set to 0.0.0.0 ONLY when a reverse proxy / VPN sits in front.
HUB_BIND=127.0.0.1

# Host directory persisted into the container at /data (db, uploads, keys).
HUB_DATA_DIR=./data

# ─── identity / app pairing ────────────────────────────────────────────────
# RESERVED — not enforced today. The server does not read this value and the
# API does not require it; access control is the network boundary (see
# SECURITY.md). install.sh still fills it so existing installs keep working if
# enforcement is added later. Do NOT rely on it to protect an exposed port.
HUB_API_TOKEN=

# Origins allowed to call the API (comma-separated). Add your app's origin.
HUB_ORIGIN=http://localhost:8081

# Public base URL the server advertises to clients (your reachable hostname).
HUB_PUBLIC_BASE=http://127.0.0.1:8090

# Display identity shown in the app.
HUB_USER_NAME=Your Name
HUB_USER_HANDLE=you
HUB_TZ=UTC

# ─── optional integrations ─────────────────────────────────────────────────
# Leave blank to run standalone; the hub works without any of these.
HERMES_API_BASE=
HERMES_API_KEY=
MURMUR_BRIDGE_URL=
MURMUR_BRIDGE_TOKEN=
HA_LIVE_APPLY=false
OPENROUTER_API_KEY=
