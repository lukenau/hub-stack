{
  "expo": {
    "name": "AGENT HUB",
    "slug": "hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hub",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#000d0e"
    },
    "ios": {
      "bundleIdentifier": "com.example.hub",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Hub uses Face ID to authorise writes and unlock the terminal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HubOnest-400.ttf",
            "./assets/fonts/HubOnest-500.ttf",
            "./assets/fonts/HubOnest-520.ttf",
            "./assets/fonts/HubOnest-540.ttf",
            "./assets/fonts/HubOnest-550.ttf",
            "./assets/fonts/HubOnest-560.ttf",
            "./assets/fonts/HubOnest-580.ttf",
            "./assets/fonts/HubOnest-600.ttf",
            "./assets/fonts/HubOnest-620.ttf",
            "./assets/fonts/HubOnest-640.ttf",
            "./assets/fonts/HubOnest-650.ttf",
            "./assets/fonts/HubOnest-700.ttf",
            "./assets/fonts/HubOnest-800.ttf",
            "./assets/fonts/HubMono-400.ttf",
            "./assets/fonts/HubMono-500.ttf",
            "./assets/fonts/HubMono-520.ttf",
            "./assets/fonts/HubMono-550.ttf",
            "./assets/fonts/HubMono-600.ttf",
            "./assets/fonts/HubMono-620.ttf",
            "./assets/fonts/HubMono-650.ttf",
            "./assets/fonts/HubMono-700.ttf",
            "./assets/fonts/HubMono-800.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hub attaches photos you pick to a message for Assistant.",
          "cameraPermission": "Hub can attach a photo you take to a message for Assistant."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "owner": "example",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69e62aeb-20eb-4dd7-8c7b-72ea25f5d92c"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/69e62aeb-20eb-4dd7-8c7b-72ea25f5d92c"
    }
  }
}
